# ============================================================
# Semiont Mac Dev Environment – copy this file to .env
# ============================================================
# Usage:
#   cp .devcontainer/mac/.env.example .devcontainer/mac/.env
#   # Edit .env, then open VS Code → "Reopen in Container"
#
# You only need to fill in the sections that apply to your setup.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Password for the local PostgreSQL container.
# The connection string used by the backend is auto-generated from this.
POSTGRES_PASSWORD=semiont_dev

# ── LLM Inference ────────────────────────────────────────────────────────
# Choose which local LLM service to use.
#
# Option A: Ollama  (recommended default)
#   • Make sure Ollama is running on your Mac: `ollama serve`
#   • Pull a model first:  `ollama pull llama3.2`
#
INFERENCE_TYPE=ollama
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Option B: LM Studio
#   • Open LM Studio → Developer tab → Start Server (default port 1234)
#   • Load a model in LM Studio before starting the container
#   • Comment out the Ollama lines above and uncomment these:
#
# INFERENCE_TYPE=lmstudio
# LMSTUDIO_ENDPOINT=http://host.docker.internal:1234/v1
# LMSTUDIO_MODEL=local-model

# Option C: Anthropic (cloud – requires an API key)
#   • Set INFERENCE_TYPE=anthropic and provide your key
#
# INFERENCE_TYPE=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx

# ── Neo4j Graph Database (optional) ──────────────────────────────────────
# Leave blank to use the in-memory graph (suitable for development).
# Sign up for free at https://neo4j.com/cloud/aura/
#
# NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password-here
# NEO4J_DATABASE=neo4j
