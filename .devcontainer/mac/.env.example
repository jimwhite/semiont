# ============================================================
# Semiont Mac Dev Environment – copy this file to .env
# ============================================================
# Usage:
#   cp .devcontainer/mac/.env.example .devcontainer/mac/.env
#   # Edit .env, then open VS Code → "Reopen in Container"
#
# You only need to fill in the sections that apply to your setup.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Password for the local PostgreSQL 18 container.
# The connection string used by the backend is auto-generated from this.
POSTGRES_PASSWORD=semiont_dev

# ── Neo4j ─────────────────────────────────────────────────────────────────
# Password for the local Neo4j 5 container.
# Must match NEO4J_AUTH set in docker-compose.yml (neo4j/<password>).
# The backend connects via bolt://neo4j:7687 (inside the Docker network).
NEO4J_LOCAL_PASSWORD=semiont_dev

# ── LLM Host ─────────────────────────────────────────────────────────────
# Hostname or IP address of the machine running Ollama or LM Studio.
#
# Default: host.docker.internal  – the Docker Desktop magic hostname that
#   resolves to your Mac. Works when Ollama/LM Studio runs on the same Mac.
#
# VPN note: If your Mac is on VPN and the LLM server is on a different
#   machine, set this to that machine's IP address, e.g.:
#   LLM_HOST=192.168.1.100
#
LLM_HOST=host.docker.internal

# ── LLM Inference ────────────────────────────────────────────────────────
# Choose which local LLM service to use.
#
# Option A: Ollama  (recommended default)
#   • Make sure Ollama is running:  ollama serve
#   • Pull a model first:           ollama pull llama3.2
#
INFERENCE_TYPE=ollama
OLLAMA_MODEL=llama3.2
# OLLAMA_ENDPOINT is derived from LLM_HOST automatically.
# Override here only if the port differs from the default 11434:
# OLLAMA_ENDPOINT=http://host.docker.internal:11434

# Option B: LM Studio
#   • Open LM Studio → Developer tab → Start Server (default port 1234)
#   • Load a model in LM Studio before starting the container
#   • Comment out the Ollama lines above and uncomment these:
#
# INFERENCE_TYPE=lmstudio
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_ENDPOINT is derived from LLM_HOST automatically.
# Override here only if the port differs from the default 1234:
# LMSTUDIO_ENDPOINT=http://host.docker.internal:1234/v1

# Option C: Anthropic (cloud – requires an API key)
#   • Set INFERENCE_TYPE=anthropic and provide your key
#
# INFERENCE_TYPE=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx
